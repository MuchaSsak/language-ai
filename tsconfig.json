{
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "bundler",
    "jsx": "react-native",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "./src/typings/po-types.d.ts",
    "./src/typings/types.d.ts",
    "nativewind-env.d.ts",
    "lingui.config.js"
  ],
  "extends": "expo/tsconfig.base"
}
