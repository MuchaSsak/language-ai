  "name": "linkoglot",
  "version": "0.0.0",
  "main": "index.tsx",
  "scripts": {
    "start": "npx expo start --dev-client",
    "tunstart": "npx expo start -c --tunnel --dev-client",
    "android": "npx expo run:android",
    "ios": "npx expo run:ios",
    "web": "npx expo start --web",
    "fix": "npx eslint --fix .",
    "prebuild": "npx expo prebuild",
    "typecheck": "tsc --noEmit",
    "postinstall": "node ./scripts/fix-react-navigation-assets.js",
    "doctor": "npx expo-doctor --verbose",
    "murder": "adb kill-server && stop-process -name \"qemu-system-x86_64\" -force && adb start-server",
    "translate": "lingui extract --overwrite --clean && lingui compile --typescript",
    "translate-llm": "bun ./scripts/translate-llm.js",
    "build:dev:android": "npx eas build --platform android --profile development --clear-cache",
    "build:dev:ios": "npx eas build --platform ios --profile development --clear-cache",
    "build:preview:android": "npx eas build --platform android --profile preview --clear-cache",
    "build:production:android": "npx eas build --platform android --profile production --clear-cache",
    "vercel-build": "npx expo export -p web",
    "supabase-types": "supabase gen types typescript --project-id npoyhglzsjzgxysahfnn --schema public > ./src/typings/database-generated.types.ts",
    "lazy": "bun -e \"const last = process.argv[process.argv.length - 1]; const custom = (last && last !== '-e' && !last.includes('child_process') && !last.toLowerCase().includes('bun.exe') && last !== process.argv[0]) ? last : ''; const msg = custom ? ': ' + custom : ''; require('child_process').execSync('git add . && git commit -m \\\"lock in' + msg + '\\\" && git push -u origin main', {stdio: 'inherit'});\"",
    "lint": "expo lint"
  },
